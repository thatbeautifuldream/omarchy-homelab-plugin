#!/usr/bin/env bash
set -euo pipefail

cat >&2 <<'MSG'
Omarchy rejects symlinked plugin folders and officially installs third-party plugins as git checkouts.
Using the git-managed Omarchy install/update flow instead.
MSG

exec "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)/sync-to-omarchy"
