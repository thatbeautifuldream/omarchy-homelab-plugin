#!/usr/bin/env bash
set -euo pipefail

plugin_id="thatbeautifuldream.homelab"
repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
target_dir="${HOME}/.config/omarchy/plugins/${plugin_id}"

cat <<MSG
Official Omarchy installs third-party plugins as git checkouts and updates them with:
  omarchy plugin update ${plugin_id} --yes

Installed plugin:
  ${target_dir}

Source repo:
  ${repo_root}

No rsync copy-back is needed. Commit changes in the source repo, push them, then run:
  ${repo_root}/scripts/sync-to-omarchy
MSG
